{
  "info": {
    "name": "P11 KEPL - Monitoring Prometheus & Grafana",
    "description": "Pengujian susunan monitoring Pertemuan 11: endpoint /metrics, target Prometheus, aturan alarm, keamanan login Grafana, dan pembangkit lalu lintas untuk dashboard.\n\nSebelum dipakai: isi variabel collection `grafanaPass` dengan password Grafana dari file .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Cek Susunan Monitoring",
      "description": "Jalankan satu per satu untuk memastikan semua komponen hidup. Jalankan folder 2 dulu supaya /metrics sudah berisi data.",
      "item": [
        {
          "name": "1. Backend Health (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{appUrl}}/api/health",
              "host": [
                "{{appUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "2. Endpoint /metrics Aplikasi (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Format teks Prometheus\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\");",
                  "});",
                  "pm.test(\"Berisi metrik app_http_requests_total\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"app_http_requests_total\");",
                  "});",
                  "pm.test(\"Berisi histogram durasi request\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"app_http_request_duration_seconds_bucket\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{appUrl}}/metrics",
              "host": [
                "{{appUrl}}"
              ],
              "path": [
                "metrics"
              ]
            }
          }
        },
        {
          "name": "3. Prometheus - Semua Target UP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const targets = pm.response.json().data.activeTargets;",
                  "targets.forEach(t => console.log(t.labels.job, '=>', t.health, t.lastError || ''));",
                  "pm.test(\"Ada 4 target (prometheus, container, server, backend)\", function () {",
                  "    const jobs = targets.map(t => t.labels.job).sort();",
                  "    pm.expect(jobs).to.eql([\"backend\", \"container\", \"prometheus\", \"server\"]);",
                  "});",
                  "pm.test(\"Semua target berstatus up\", function () {",
                  "    const down = targets.filter(t => t.health !== \"up\").map(t => t.labels.job + \": \" + t.lastError);",
                  "    pm.expect(down, down.join(' | ')).to.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{prometheusUrl}}/api/v1/targets?state=active",
              "host": [
                "{{prometheusUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "targets"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "4. Prometheus - Query Permintaan per Detik",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json().data.result;",
                  "res.forEach(r => console.log(r.metric.route, '=>', r.value[1], 'req/s'));",
                  "pm.test(\"Query mengembalikan data\", function () {",
                  "    pm.expect(res.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{prometheusUrl}}/api/v1/query?query=sum by (route) (rate(app_http_requests_total[5m]))",
              "host": [
                "{{prometheusUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "query"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "sum by (route) (rate(app_http_requests_total[5m]))"
                }
              ]
            }
          }
        },
        {
          "name": "5. Prometheus - Aturan Alarm Terbaca",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const rules = pm.response.json().data.groups.flatMap(g => g.rules);",
                  "const r = rules.find(x => x.name === \"BackendMati\");",
                  "pm.test(\"Aturan BackendMati ada\", function () {",
                  "    pm.expect(r).to.not.be.undefined;",
                  "});",
                  "pm.test(\"Aturan memakai for: (duration > 0) dan anotasi action\", function () {",
                  "    pm.expect(r.duration).to.be.above(0);",
                  "    pm.expect(r.annotations.action).to.not.be.empty;",
                  "});",
                  "console.log('State BackendMati:', r && r.state);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{prometheusUrl}}/api/v1/rules?type=alert",
              "host": [
                "{{prometheusUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rules"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "alert"
                }
              ]
            }
          }
        },
        {
          "name": "6. Prometheus - Status Alarm Saat Ini",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const alerts = pm.response.json().data.alerts;",
                  "alerts.forEach(a => console.log(a.labels.alertname, '=>', a.state));",
                  "// Normal: kosong. Setelah 'docker compose stop backend': pending lalu firing",
                  "pm.test(\"Daftar alarm terbaca\", function () {",
                  "    pm.expect(alerts).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
